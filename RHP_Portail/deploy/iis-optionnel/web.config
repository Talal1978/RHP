<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config OPTIONNEL — frontal IIS avec HTTPS devant RHP_Portail.

  Cas d'usage : le client exige du HTTPS (ou le port 443 standard) alors que
  le portail tourne en HTTP sur localhost:3500. IIS sert de reverse proxy.

  Prérequis sur le serveur (rôle/fonctionnalités Windows) :
    - IIS (service Web)
    - Module "Application Request Routing" (ARR) + "URL Rewrite"
      (via Web Platform Installer : "Application Request Routing 3.0")
    - Activer le proxy dans ARR : IIS Manager > server > Application Request
      Routing Cache > Server Proxy Settings > cocher "Enable proxy"
    - Fonctionnalité "Protocole WebSocket" activée (socket.io du portail)

  Installation : placer ce fichier à la racine du site IIS (ex.
  C:\inetpub\rhp) et y lier le certificat HTTPS (liaisons du site).

  Adapter BACKEND_URL ci-dessous si le port n'est pas 3500.

  Penser alors à mettre dans le .env du backend :
    TRUST_PROXY=1
    COOKIE_SECURE=true
    ALLOWED_ORIGINS=https://portail.monclient.ma
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="RHP_Portail_ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3500/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Conserver l'en-tête Host d'origine (utile pour les logs et CORS) -->
    <proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />
  </system.webServer>
</configuration>

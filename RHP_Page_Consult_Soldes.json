  "businessSources": [
    {
      "Cod_Source": "SRC_SOLDES_CONGES",
      "Libelle": "Soldes de congés par agent et année",
      "Typ_Source": "SQL",
      "Code_Sql": "select c.Matricule, isnull(a.Nom_Agent, '') + ' ' + isnull(a.Prenom_Agent, '') as Nom_Agent, c.Annee, c.Droit_Conge, c.Conge_Pris, c.Solde_Conge from RH_Conge c left join RH_Agent a on a.id_Societe = c.id_Societe and a.Matricule = c.Matricule where c.id_Societe = @id_Societe and (@Annee is null or c.Annee = @Annee) and (@Matricule is null or c.Matricule like '%' + @Matricule + '%') order by c.Annee desc, c.Matricule",
      "Parametres": "[{\"Nom\":\"Annee\",\"Typ\":\"int\",\"Obligatoire\":false},{\"Nom\":\"Matricule\",\"Typ\":\"nvarchar\",\"Obligatoire\":false}]",
      "Typ_Retour": "TABLE",
      "Actif": true
    }
